{
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "jaffskils": {
      "source": {
        "source": "github",
        "repo": "jafforgehq/jaffskils"
      }
    },
    "abhi-plugins": {
      "source": {
        "source": "github",
        "repo": "maneabhishek1983/claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "rtk@jaffskils": true,
    "omniroute@abhi-plugins": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/install-tools.sh"
          }
        ]
      }
    ]
  }
}
